# Copy to .env.local to test locally (git-ignored). Keep server-only values unprefixed.
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/manual.js

# Server-only Instagram Graph API + Vercel Blob settings. Never prefix these with VITE_.
# Configure these in Vercel Project Settings > Environment Variables.
# INSTAGRAM_USER_ID=your_instagram_professional_account_id
# INSTAGRAM_ACCESS_TOKEN=your_server_side_graph_api_access_token
# INSTAGRAM_GRAPH_API_VERSION=v26.0
# CRON_SECRET=generate_a_long_random_secret
# BLOB_READ_WRITE_TOKEN=provided_when_connecting_a_public_vercel_blob_store
